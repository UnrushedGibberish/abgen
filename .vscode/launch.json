{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api-debug-preparation",
      "program": "${workspaceFolder}/src/api/bin/Debug/net10.0/AbGen.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5014"
      }
    },
    {
      "name": "frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev -- --host 127.0.0.1",
      "cwd": "${workspaceFolder}/src/frontend",
      "env": {
        "VITE_API_BASE_URL": "http://localhost:5014"
      },
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "Local:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + Vite (local PostgreSQL)",
      "configurations": [
        "api",
        "frontend"
      ],
      "stopAll": true
    }
  ]
}
