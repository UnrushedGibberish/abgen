{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api-debug-preparation",
      "program": "${workspaceFolder}/src/api/bin/Debug/net10.0/AbGen.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:${config:abgen.localApiPort}",
        "ConnectionStrings__Postgres": "Host=127.0.0.1;Port=${config:abgen.localPostgresPort};Database=abgen;Username=abgen;development-only",
        "Cors__AllowedOrigins__0": "http://127.0.0.1:${config:abgen.localFrontendPort}",
        "Cors__AllowedOrigins__1": "http://localhost:${config:abgen.localFrontendPort}"
      }
    },
    {
      "name": "frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev -- --host 127.0.0.1",
      "cwd": "${workspaceFolder}/src/frontend",
      "env": {
        "ABGEN_API_PORT": "${config:abgen.localApiPort}",
        "ABGEN_FRONTEND_PORT": "${config:abgen.localFrontendPort}",
        "VITE_API_BASE_URL": ""
      },
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "Local:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + Vite (local PostgreSQL)",
      "configurations": [
        "api",
        "frontend"
      ],
      "stopAll": true
    }
  ]
}
